# ── Required ──────────────────────────────────────────────────────────────────

# Your Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_token_here

# ── Optional tuning ───────────────────────────────────────────────────────────

# HuggingFace model for zero-shot classification (default is fast & small ~150MB)
# Swap for facebook/bart-large-mnli for better accuracy (~1.6GB)
HF_MODEL=cross-encoder/nli-deberta-v3-small

# Confidence threshold: score above this → flagged as propaganda (0.0 – 1.0)
CONFIDENCE_THRESHOLD=0.45
